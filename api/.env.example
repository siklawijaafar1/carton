# ---------- Base de données ----------
# Local : PGlite via `npm run db:local` (lancé automatiquement par `npm run dev`)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"
# Production : PostgreSQL (Supabase, Neon, Render…), ex.
# DATABASE_URL="postgresql://user:pass@host:5432/carton?sslmode=require"

PORT=4000
PUBLIC_API_URL="http://localhost:4000"   # URL publique de l'API (webhooks, images WhatsApp)
PUBLIC_WEB_URL="http://localhost:3300"   # URL du site (liens RSVP, retours de paiement, CORS)
ADMIN_TOKEN="changez-moi-avec-une-longue-chaine-aleatoire"
STORAGE_DIR=".data/storage"              # stockage disque (dev) si Supabase n'est pas configuré

# ---------- Stockage production : Supabase Storage (bucket privé) ----------
SUPABASE_URL=""                          # https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=""             # clé service_role (serveur uniquement)
SUPABASE_BUCKET="carton"

# Démo en production sans CinetPay (sinon l'API refuse de démarrer)
ALLOW_PAYMENT_SIMULATION="false"

# ---------- Paiement : CinetPay (Wave, Orange Money, MTN MoMo, Moov, cartes) ----------
# Vides → page de simulation locale (refusée si NODE_ENV=production)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""                   # clé secrète pour vérifier l'en-tête x-token des notifications

# ---------- Fond IA (formule Super) — facultatif ----------
FAL_KEY=""                               # fal.ai FLUX schnell (prioritaire)
POLLINATIONS_KEY=""                      # sinon Pollinations (sans clé : palier gratuit lent + filigrane)

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="invitation_evenement" # modèle approuvé : en-tête IMAGE + {{1}} invité, {{2}} événement, {{3}} lien
WHATSAPP_TEMPLATE_LANG="fr"

# ---------- SMS : Orange SMS API Côte d'Ivoire ----------
ORANGE_SMS_CLIENT_ID=""
ORANGE_SMS_CLIENT_SECRET=""
ORANGE_SMS_SENDER=""                     # ex. tel:+2250700000000
SMS_SENDER_NAME="CARTON"
